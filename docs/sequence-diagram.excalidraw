      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Classes:\n• WeaverAgent - Main orchestrator (weaver.py)\n• AuthenticationManager - Auth handling (auth.py)\n• DatabricksPlugin - Source extraction (plugin.py)\n• SemanticModelTransformer - Model conversion\n• FabricClient - Fabric API client",
      "autoResize": true,
