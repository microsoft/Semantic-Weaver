    {
      "id": "legend-col1",
      "type": "text",
      "x": 60,
      "y": 1540,
      "width": 320,
      "height": 130,
      "text": "Classes:\n• WeaverAgent - Main orchestrator (weaver.py)\n• AuthenticationManager - Auth handling (auth.py)\n• DatabricksPlugin - Source extraction (plugin.py)\n• SemanticModelTransformer - Model conversion\n• FabricClient - Fabric API client",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
